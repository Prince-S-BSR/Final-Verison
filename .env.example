# Copy to .env and fill in real values. Never commit .env (see .gitignore).
#
# One root .env.example documents every variable used across the monorepo
# (apps/web, apps/api, packages/db) rather than per-app files, since Phase 0
# has exactly one database and one backend service.

# --- packages/db --------------------------------------------------------
# Postgres connection string. Local dev target; production is AWS RDS
# PostgreSQL per docs/architecture/00-phase-0-architecture-note.md §2.2.
# The app connects as the non-superuser `crm_app` role (§3.5), never as the
# table owner or a superuser.
DATABASE_URL=postgresql://user:password@localhost:5432/crm_dev

# --- apps/api -------------------------------------------------------------
PORT=4000
NODE_ENV=development
